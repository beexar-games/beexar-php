{
    "name": "beexar/sdk",
    "description": "Beexar operator SDK — launch game sessions and serve the four seamless-wallet callbacks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://docs.beexar.com/tools/sdk-php/",
    "keywords": [
        "beexar",
        "casino",
        "seamless-wallet",
        "game-aggregator",
        "softswiss",
        "betwin",
        "rollback"
    ],
    "support": {
        "docs": "https://docs.beexar.com",
        "issues": "https://github.com/beexar-games/beexar-php/issues"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "suggest": {
        "psr/http-server-middleware": "To mount the wallet as PSR-15 middleware (Beexar\\Http\\WalletMiddleware)",
        "psr/http-factory": "Required alongside psr/http-server-middleware"
    },
    "autoload": {
        "psr-4": {
            "Beexar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beexar\\Tests\\": "tests/",
            "Beexar\\Examples\\": "examples/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
